# =============================================================================
# KeluarBerapa backend - environment variables
# =============================================================================
# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# Real environment variables always take precedence over .env, so a deployment
# can ignore this file entirely. NEVER commit a filled-in .env: it is listed in
# .gitignore and holds credentials.
#
# Legend:  [required]  must be set
#          [prod]      additionally required when APP_ENV=production
#          [optional]  has a working default, shown after the "=" sign
# =============================================================================


# --- Application -------------------------------------------------------------

# [optional] development | test | staging | production
# In production, every [prod] variable below becomes mandatory and a "*" CORS
# origin is rejected.
APP_ENV=development

# [optional] Reported by /health and attached to every log line.
APP_NAME=keluarberapa-api
APP_VERSION=0.1.0

# [optional] debug | info | warn | error
LOG_LEVEL=info

# [optional] json (for deployments) | text (easier to read locally)
LOG_FORMAT=json

# [optional] IANA timezone used to render dates and bucket monthly summaries.
APP_TIMEZONE=Asia/Jakarta


# --- HTTP server -------------------------------------------------------------

# [optional]
HTTP_HOST=0.0.0.0
PORT=8080

# [optional] Go duration strings, e.g. 10s, 1m, 2h.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# [optional] Grace period for in-flight requests during shutdown.
HTTP_SHUTDOWN_TIMEOUT=15s

# [optional] Comma-separated exact origins allowed to call the API. The default
# is the Astro dev server. "*" is rejected when APP_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:4321


# --- PostgreSQL --------------------------------------------------------------

# [required] PostgreSQL 13 or newer (the schema uses the core gen_random_uuid()).
# Add ?sslmode=require for any non-local database.
DATABASE_URL=postgres://keluarberapa:change-me@localhost:5432/keluarberapa?sslmode=disable

# [optional] Connection pool sizing. DATABASE_MIN_CONNS must not exceed MAX.
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

# [optional] Budget for opening a connection at startup.
DATABASE_CONNECT_TIMEOUT=5s

# [optional] Budget for the database ping behind GET /ready.
DATABASE_HEALTH_TIMEOUT=2s

# [optional] Apply pending migrations when the API starts. Handy locally; leave
# it false where migrations run as a separate deploy step.
DATABASE_AUTO_MIGRATE=false


# --- Authentication ----------------------------------------------------------
# Tokens are issued in the authentication stage. The secrets are validated at
# startup so a misconfiguration fails immediately rather than on first login.

# [prod] At least 32 characters, and the two must differ. Generate with:
#     openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# [optional] architecture.md: 15m access token, 30d refresh token.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# [optional] "iss" claim.
JWT_ISSUER=keluarberapa


# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# Consumed by the WhatsApp stage. One central bot number serves every user.

# [prod] Shared string you choose; Meta echoes it during webhook verification.
WHATSAPP_VERIFY_TOKEN=

# [prod] Permanent access token of the Meta system user.
WHATSAPP_ACCESS_TOKEN=

# [prod] Meta app secret, used to verify the X-Hub-Signature-256 header on
# every inbound webhook.
WHATSAPP_APP_SECRET=

# [prod] Phone number id of the central bot number.
WHATSAPP_PHONE_NUMBER_ID=

# [optional]
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0


# --- Tests -------------------------------------------------------------------

# [optional] Connection string for the database integration tests. When unset,
# those tests are skipped and `go test ./...` still passes. Point it at a
# throwaway database: the tests create and drop schemas inside it.
# TEST_DATABASE_URL=postgres://keluarberapa:change-me@localhost:5432/keluarberapa_test?sslmode=disable
